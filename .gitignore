# ============================================================
# WWE '13 Recompilation — .gitignore
# ============================================================

# CMake build output
out/
build/
CMakeFiles/
cmake_install.cmake
CMakeCache.txt
CTestTestfile.cmake
_deps/

# Ninja
.ninja_deps
.ninja_log

# CMake Presets user overrides
CMakeUserPresets.json

# Generated source files (produced by rexglue codegen tool)
# These are re-generated from the XEX binary and must not be committed.
src/generated/

# Compiled binaries and libraries
*.exe
*.dll
*.lib
*.pdb
*.ilk
*.exp
*.obj
*.o
*.a
*.so
*.dylib

# Debug info
*.pdb
*.dSYM/

# Visual Studio
.vs/
*.suo
*.user
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
ipch/
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# CLion / JetBrains
.idea/
*.iml
cmake-build-*/

# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Kiro
.kiro/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
.env
.venv
venv/

# Game data (never commit game files)
*.xex
*.iso
*.xcp
*.nxe
*.stfs
game_data/
user_data/

# Logs
*.log
logs/

# Tracy profiler captures
*.tracy

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Patch files
*.orig
*.rej
*.patch

# Backup files
*~
*.bak
*.swp
*.tmp
